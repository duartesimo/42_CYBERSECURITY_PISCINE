#!/usr/bin/env python3

from datetime import datetime
from PIL import Image, ExifTags
import os
import argparse
import subprocess

allowed_extensions = [".jpg", ".jpeg", ".png", ".gif", ".bmp"]

# Display basic file information
def display_file_info(file):

    info = os.stat(file)
    date_format = "%d/%m/%Y %H:%M:%S"
    creation_time = int(subprocess.check_output(["stat", "-c", "%W", "--", file]))

    print(f"Filename: \033[92m{os.path.basename(file)}\033[0m")
    print(f"Path: {os.path.abspath(file)}")
    print(f"Size: {info.st_size} bytes")

    if creation_time != 0:
        print(f"Creation date: {datetime.fromtimestamp(creation_time).strftime(date_format)}")
    else:
        print("Creation date: Not available")

    print(f"Last modified: {datetime.fromtimestamp(info.st_mtime).strftime(date_format)}")
    print(f"Last accessed: {datetime.fromtimestamp(info.st_atime).strftime(date_format)}")
    print(f"Metadata changed: {datetime.fromtimestamp(info.st_ctime).strftime(date_format)}")
    print()

# Display basic image information
def display_image_info(file):

    with Image.open(file) as img:
        print("\033[94mImage properties:\033[0m")
        print(f"Format: {img.format}")
        print(f"Width: {img.width} pixels")
        print(f"Height: {img.height} pixels")
        print(f"Color mode: {img.mode}")
        for key, value in img.info.items():
            if key != "exif" and not isinstance(value, bytes):
                print(f"{key}: {value}")
        print()

# Display EXIF information
def display_exif_info(file):

    with Image.open(file) as img:

        exif = img.getexif()
        if not exif:
            print("\033[91mNo EXIF metadata found.\033[0m")
            print()
            return

        print("\033[94mEXIF metadata:\033[0m")
        for tag, value in exif.items():
            name = ExifTags.TAGS.get(tag, tag)
            print(f"{name}: {value}")
        print()

# Parse command-line arguments
def parse_arguments():
    parser = argparse.ArgumentParser()
    parser.add_argument("files", nargs="+")
    return parser.parse_args()

# Main function
def main():

    args = parse_arguments()

    for file in args.files:
        if not os.path.isfile(file):
            print(f"File not found: {file}")
            continue

        extension = os.path.splitext(file)[1].lower()
        if extension not in allowed_extensions:
            print(f"Invalid extension: {file}")
            continue

        try:
            display_file_info(file)
            display_image_info(file)
            display_exif_info(file)
        except (OSError, subprocess.CalledProcessError):
            print(f"Failed to process file: {file}")

        print("==========================================\n")

main()
