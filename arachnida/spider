#!/usr/bin/env python3

from html.parser import HTMLParser
from urllib.parse import urljoin, urlparse
import sys
import requests
import os
import argparse

images = []
links = []
allowed_extensions = [".jpg", ".jpeg", ".png", ".gif", ".bmp"]

# Define command-line arguments
def parse_arguments():
    parser = argparse.ArgumentParser()
    parser.add_argument("url")
    parser.add_argument("-r", action="store_true")
    parser.add_argument("-l", type=int, default=5)
    parser.add_argument("-p", type=str, default="./data/")

    return parser.parse_args()

# Extract image sources and page links from HTML tags
class PageParser(HTMLParser):

    def handle_starttag(self, tag, attrs):
        if tag == 'img':
            for name, value in attrs:
                if name == 'src':
                    images.append(value)

        elif tag == 'a':
            for name, value in attrs:
                if name == 'href':
                    links.append(value)

# Get response
def get_response(url):
    try:
        response = requests.get(url, timeout=10)
    except requests.exceptions.RequestException:
        print("Failed to connect")
        return None

    if response.status_code != 200:
        print("HTTP request failed")
        return None

    return response

# Extract image and links into list
def extract_images(response):
    images.clear()
    links.clear()

    parser = PageParser()
    parser.feed(response.text)

    complete_url_images = []
    complete_url_links = []

    for image in images:
        result = urljoin(response.url, image)
        complete_url_images.append(result)

    for link in links:
        if not link:
            print("Invalid link")
            continue

        result = urljoin(response.url, link)

        if urlparse(result).scheme not in ["http", "https"]:
            continue

        if urlparse(result).netloc != urlparse(response.url).netloc:
            continue

        complete_url_links.append(result)

    return complete_url_images, complete_url_links

# Download images to folder
def download_images(complete_url_images, download_path):
    os.makedirs(download_path, exist_ok=True)

    for image_url in complete_url_images:
        name = urlparse(image_url).path.split("/")[-1]

        extension = os.path.splitext(name)[1].lower()
        if extension not in allowed_extensions:
            print("Invalid extension")
            continue

        image_response = get_response(image_url)

        if image_response is None:
            continue

        path = os.path.join(download_path, name)

        with open(path, "wb") as f:
            f.write(image_response.content)

# Main function
def main():

    args = parse_arguments()
    response = get_response(args.url)

    if response is None:
        sys.exit(1)

    complete_url_images, complete_url_links = extract_images(response)
    download_images(complete_url_images, args.p)
    print(complete_url_links)

main()
