#!/usr/bin/env python3

from html.parser import HTMLParser
from urllib.parse import urljoin
import sys
import requests
import os

images = []

# Extract image sources from HTML tags
class ImageParser(HTMLParser):

    def handle_starttag(self, tag, attrs):
        if tag == 'img':
            for name, value in attrs:
                if name == 'src':
                    images.append(value)

# Validate command-line arguments
if len(sys.argv) != 2:
    print("Usage: ./spider URL")
    sys.exit(1)

url = sys.argv[1]

# Request the HTML content of the webpage
response = requests.get(url, timeout=10)

# Parse HTML and collect image sources
parser = ImageParser()
parser.feed(response.text)

# Convert relative image URLs into absolute URLs
complete_url_images = []

for image in images:
    result = urljoin(response.url, image)
    complete_url_images.append(result)

# Download and save images
download_path = "./data/"
os.makedirs(download_path, exist_ok=True)

for image_url in complete_url_images:
    image_response = requests.get(image_url, timeout=10)
    name = image_response.url.split("/")[-1]
    path = os.path.join(download_path, name)
    
    with open(path, "wb") as f:
        f.write(image_response.content)
