#!/usr/bin/env python3

from html.parser import HTMLParser
import sys
import requests

images = []

class ImageParser(HTMLParser):

    def handle_starttag(self, tag, attrs):
        if tag == 'img':
            for name, value in attrs:
                if name == 'src':
                    images.append(value)

if len(sys.argv) != 2:
    print("Usage: ./spider URL")
    sys.exit(1)

url = sys.argv[1]
response = requests.get(url, timeout=10)

parser = ImageParser()
parser.feed(response.text)

print(images)
