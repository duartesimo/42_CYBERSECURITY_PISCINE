#!/usr/bin/env python3

from cryptography.fernet import Fernet
import argparse
import os

# Parse command-line arguments
def parse_arguments():
    parser = argparse.ArgumentParser()
    parser.add_argument("-g", type=str)
    parser.add_argument("-k", type=str)

    return parser.parse_args()

# Read and validate hexadecimal key
def read_key(file):

    if not os.path.isfile(file):
        print(f"File not found: {file}")
        return None

    with open(file, "r") as f:
        key = f.read().strip()

    hex_chars = "0123456789abcdefABCDEF"

    if len(key) < 64:
        print("Key is too short")
        return None

    if len(key) % 2 != 0:
        print("Key must have an even number of characters")
        return None

    for char in key:
        if char not in hex_chars:
            print("Invalid hexadecimal character")
            return None

    return key

# Encrypt hexadecimal key
def encrypt_key(key):

    encryption_key = Fernet.generate_key()

    cipher = Fernet(encryption_key)

    encrypted_key = cipher.encrypt(key.encode())

    return encrypted_key, encryption_key

# Save encrypted key and encryption key
def save_key(encrypted_key, encryption_key):

    fd = os.open("ft_otp.key", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)

    with os.fdopen(fd, "wb") as f:
        f.write(encrypted_key)

    fd = os.open(".encryption.key", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)

    with os.fdopen(fd, "wb") as f:
        f.write(encryption_key)

# Decrypt hexadecimal key
def decrypt_key(file):

    if not os.path.isfile(file):
        print(f"File not found: {file}")
        return None

    if not os.path.isfile(".encryption.key"):
        print("Encryption key file not found")
        return None

    with open(file, "rb") as f:
        encrypted_key = f.read()

    with open(".encryption.key", "rb") as f:
        encryption_key = f.read()

    cipher = Fernet(encryption_key)
    decrypted_key = cipher.decrypt(encrypted_key)

    return decrypted_key.decode()

# Main function
def main():
    args = parse_arguments()

    if args.g:
        key = read_key(args.g)

        if key is not None:
            encrypted_key, encryption_key = encrypt_key(key)
            save_key(encrypted_key, encryption_key)
            print("Key was successfully saved in ft_otp.key.")

    if args.k:
        key = decrypt_key(args.k)

        if key is not None:
            print("Key successfully decrypted")

    if not args.g and not args.k:
        print("Usage: ./ft_otp [-g FILE] [-k FILE]")


main()
